# ==========================================
# 跌倒检测系统 - 环境变量示例
# ==========================================
# 复制此文件为 .env 并填入你的实际配置：
#   cp .env.example .env
# ⚠️ .env 已加入 .gitignore，不会被提交

# ---------- 模型 ----------
# 模型类别数（背景 + 跌倒 + 其他行为）
NUM_CLASSES=3
# 序列长度（时间窗口）
SEQUENCE_LENGTH=30
# 输入特征维度
INPUT_DIM=6

# ---------- 训练 ----------
EPOCHS=50
BATCH_SIZE=64
LEARNING_RATE=0.0005
EARLY_STOPPING_PATIENCE=7

# ---------- 推理 ----------
# 推理置信度阈值
CONFIDENCE_THRESHOLD=0.85
# 模型保存路径
MODEL_PATH=models/best.pt
